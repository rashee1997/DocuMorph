# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source formats
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.manifest text eol=lf

# Binary assets
*.ico binary
*.png binary
*.exe binary
*.dll binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
